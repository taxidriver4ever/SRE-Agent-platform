# Root Compose development configuration. Existing production/local secrets are not copied.
APPLICATION_MYSQL_ROOT_PASSWORD=local_root_change_me
APPLICATION_MYSQL_PASSWORD=local_agent_change_me
LAB_MYSQL_ROOT_PASSWORD=local_lab_change_me
SRE_INITIAL_USERNAME=admin
SRE_INITIAL_PASSWORD=local_login_change_me
GATEWAY_API_KEY=
GATEWAY_MODEL=vllm/qwen3-4b
VLLM_BASE_URL=http://host.docker.internal:18000/v1
VLLM_API_KEY=EMPTY
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Search projections; MySQL remains authoritative.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_LOG_INDEX=sre-logs-*
ELASTICSEARCH_LOG_PREFIX=sre-logs
ELASTICSEARCH_HISTORY_INDEX=sre-agent-history-v1
ELASTICSEARCH_EVENT_INDEX=sre-agent-events
HISTORY_SEARCH_ENABLED=true
HISTORY_TIMEOUT_SECONDS=2
HISTORY_TOP_K=5
