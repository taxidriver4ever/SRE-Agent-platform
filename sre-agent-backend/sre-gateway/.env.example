# Gateway SQLite 数据库。容器中 compose.yaml 会覆盖为 /app/data/auth.db。
GATEWAY_AUTH_DB=data/auth.db

# 可选的公网模型厂商配置；只使用 Ollama 时可以保持为空。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本机直接运行 Gateway 时使用；容器中会覆盖为 http://ollama:11434。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 首次 compose up 自动拉取的模型。
OLLAMA_MODEL=qwen3:4b
PROVIDER_TIMEOUT_SECONDS=180
# Docker MinIO 本地实验凭证。共享环境请替换为随机长密码，并同步到 Agent 环境变量。
MINIO_ROOT_USER=sreagent
MINIO_ROOT_PASSWORD=sreagent-dev-secret
# 逗号分隔允许的前端 Origin；浏览器预签名直传需要 MinIO 返回 CORS Header。
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
