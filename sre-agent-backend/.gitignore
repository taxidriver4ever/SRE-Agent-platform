# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/

# Local environment files and secrets; keep safe templates
.env
.env.*
!.env.example
!.env.*.example

# Runtime database data, including backend/data/mysql, must stay outside modules.
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Logs, temporary files and process state
*.log
*.pid
tmp/
temp/
.cache/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
