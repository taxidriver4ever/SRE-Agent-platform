# sre-gateway 服务地址；Agent 默认在 8001，Gateway 默认在 8000。
GATEWAY_BASE_URL=http://127.0.0.1:8000
# 访问 Gateway 的用户 Token，不是 OpenAI 等模型厂商 API Key。
GATEWAY_API_KEY=gw_sk_replace_me
# provider/model 格式的网关模型路由名。
GATEWAY_MODEL=ollama/qwen3:4b
# 单轮 LLM HTTP 请求超时秒数。
GATEWAY_TIMEOUT_SECONDS=180
# 单次任务最大推理轮数，用于阻止失控循环。
AGENT_MAX_ITERATIONS=8
# 本地 Kind 实验命名空间；Kubernetes MCP 默认只调查该空间。
KUBERNETES_NAMESPACE=sre-lab
# 第三方 containers/kubernetes-mcp-server 固定版本；Agent 通过 npx stdio 惰性启动。
KUBERNETES_MCP_VERSION=0.0.65
# 可选：生产环境指向只读 ServiceAccount 的专用 kubeconfig，而非管理员 kubeconfig。
# KUBERNETES_MCP_KUBECONFIG=C:\Users\you\.kube\sre-agent-reader.kubeconfig
# 三个可观测后端通过 Kind NodePort 暴露给宿主机 Agent。
PROMETHEUS_BASE_URL=http://127.0.0.1:19090
LOKI_BASE_URL=http://127.0.0.1:13100
TEMPO_BASE_URL=http://127.0.0.1:13200
# MySQL Tool 使用只读 sre_reader，代码层还会再次拦截写 SQL。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13307
MYSQL_USER=sre_reader
MYSQL_PASSWORD=sre_reader_dev_only
MYSQL_DATABASE=sre_lab
# Git Tool 只读取此仓库；Service Catalog 负责自然语言服务映射和源码路径。
SRE_REPOSITORY_PATH=D:\SRE-Agent-platform\sre-broken-system
SERVICE_CATALOG_PATH=D:\SRE-Agent-platform\sre-broken-system\sre-lab-infra\service-catalog.yaml
# K8s 注解绑定远程 URL 后，只在该独立目录创建浅克隆缓存，不修改业务工作树。
SRE_REPOSITORY_CACHE_PATH=D:\SRE-Agent-platform\.cache\sre-agent-repositories
# 限制 repository-url 的主机，防止恶意工作负载注解诱导 Agent 访问内网。
SRE_REPOSITORY_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
# 每次外部 Tool 的超时与进入模型上下文的最大字符数。
TOOL_TIMEOUT_SECONDS=15
TOOL_OUTPUT_LIMIT=12000
# Docker MinIO 保存 Evidence 原文、用户附件和超长粘贴日志；SQLite 只保存 oss_key。
# Agent 当前运行在宿主机，因此内部访问地址和浏览器可访问的签名 Host 相同。
MINIO_ENDPOINT=127.0.0.1:19100
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19100
MINIO_ACCESS_KEY=sreagent
MINIO_SECRET_KEY=sreagent-dev-secret
MINIO_BUCKET=sre-agent-evidence
MINIO_SECURE=false
# 预签名 URL 只在浏览器内存保留 15 分钟，不写 localStorage 或数据库。
MINIO_PRESIGN_EXPIRE_MINUTES=15
# 单对象最大 50 MiB；PUT 完成后后端还会用 stat_object 再校验真实大小。
UPLOAD_MAX_BYTES=52428800
# 超过 12 KiB 的粘贴内容由前端转换为 .log，先上传 MinIO 再提交问题。
LARGE_TEXT_THRESHOLD_BYTES=12288
ACTIVE_CONTEXT_CHARACTER_BUDGET=8000
# 登录与会话业务数据使用独立 SQLite；密码仅保存 PBKDF2 哈希。
APPLICATION_DATABASE_PATH=.data/sre-agent.sqlite3
# 每个登录 Token 默认 24 小时到期，注销会立即在数据库标记撤销。
AUTH_TOKEN_TTL_HOURS=24
# 本地首次启动账号。共享部署前必须通过安全环境变量修改默认密码。
SRE_INITIAL_USERNAME=admin
SRE_INITIAL_PASSWORD=admin123
