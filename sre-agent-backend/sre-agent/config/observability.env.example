PROMETHEUS_URL=http://127.0.0.1:19090
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PATTERN=sre-logs-*
SKYWALKING_OAP_URL=http://127.0.0.1:12800
SKYWALKING_ZIPKIN_URL=http://127.0.0.1:19412/zipkin
SKYWALKING_BEARER_TOKEN=
SKYWALKING_SERVICE_NAME=sre-agent
SKYWALKING_AGENT_ENABLED=true
SKYWALKING_AGENT_COLLECTOR=127.0.0.1:11800
TOOL_TIMEOUT_SECONDS=15
TOOL_OUTPUT_LIMIT=12000
ELASTICSEARCH_HISTORY_INDEX=sre-agent-history-v1
ELASTICSEARCH_LOG_INDEX=sre-logs-*
HISTORY_SEARCH_ENABLED=true
HISTORY_TIMEOUT_SECONDS=2
HISTORY_TOP_K=5
HISTORY_LOOKBACK_DAYS=365
HISTORY_CONTEXT_CHARS=4000
HISTORY_SYNC_INTERVAL_SECONDS=30
HISTORY_SYNC_BATCH_SIZE=20
LOGSTASH_URL=http://127.0.0.1:18090
# Filebeat reads LOGSTASH_HOST / LOGSTASH_PORT (defaults: logstash / 5044).
